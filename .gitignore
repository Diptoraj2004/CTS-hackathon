# LanceDB local data
backend/rag/lancedb_data/

# Runtime state — uploaded documents, the vector DB, the version registry,
# the audit log and review queue. Generated at runtime, not source, differs
# machine to machine, and audit_log.jsonl/review_queue.json grow on every
# run — committing them guarantees a merge conflict the next time anyone
# else runs the app locally.
data/uploads/
data/vector_db/
data/audit/

