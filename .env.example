# Backend runtime
# Set these to any local admin credentials you want to use in the Admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
AUTH_SECRET=change-me-long-random-signing-secret
AUTH_DB_PATH=data/auth.sqlite3
AUTH_TOKEN_TTL_SECONDS=3600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
OAUTH_FRONTEND_REDIRECT=http://localhost:5173/login
RATE_LIMIT_DB_PATH=data/rate_limit.sqlite3

# RAG and ingestion
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
TESSERACT_CMD=tesseract
POOR_EXTRACTION_THRESHOLD=50
PRINTABLE_RATIO_THRESHOLD=0.7
OLLAMA_MODEL=llama3.2
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Frontend
VITE_API_BASE=http://localhost:8000
